/* Antarium HUD. Colours follow the earthy terrain palette; tweak freely. */
.hud {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-font-definition: url("Fonts/VT323-Regular.asset");
}

.top-bar {
    flex-direction: row;
    justify-content: center;
    padding-top: 6px;
}

.resources {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    background-color: rgba(22, 14, 10, 0.88);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    padding: 4px 10px;
}

.resource {
    flex-direction: row;
    align-items: center;
    margin: 0 8px;
}

.resource__swatch {
    width: 8px;
    height: 8px;
    margin-right: 5px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

.resource__label {
    color: rgb(240, 230, 210);
    font-size: 20px;
    padding: 0;
}

.resource--full .resource__label {
    color: rgb(255, 200, 110);
}

.alert-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.alert {
    color: rgb(255, 130, 100);
    font-size: 20px;
    background-color: rgba(40, 6, 4, 0.8);
    padding: 3px 10px;
}

.hidden {
    display: none;
}

.debug {
    position: absolute;
    left: 8px;
    top: 8px;
    color: rgb(255, 255, 255);
    font-size: 11px;
    -unity-font-definition: initial;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 4px 6px;
}

.bottom {
    position: absolute;
    left: 0; right: 0; bottom: 10px;
    flex-direction: column;
    align-items: center;
}

.toolbar {
    flex-direction: row;
    justify-content: center;
}

.palette {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 6px;
    background-color: rgba(22, 14, 10, 0.88);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    padding: 4px;
}

.building {
    width: 104px;
    height: 44px;
    margin: 2px;
    padding: 2px 4px;
    background-color: rgb(40, 26, 18);
    border-width: 2px;
    border-color: rgb(70, 48, 32);
    border-radius: 0;
    flex-direction: row;
    align-items: center;
}

.building:hover {
    background-color: rgb(62, 41, 28);
}

.building--active {
    border-color: rgb(255, 190, 90);
    background-color: rgb(86, 54, 30);
}

.building__swatch {
    width: 8px;
    height: 30px;
    margin-right: 5px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}

.building__text {
    flex-grow: 1;
    flex-shrink: 1;
}

.building__name {
    color: rgb(240, 230, 210);
    font-size: 16px;
    padding: 0;
    margin: 0;
}

.building__cost {
    color: rgb(190, 175, 150);
    font-size: 16px;
    padding: 0;
    margin: 0;
    white-space: normal;
}

.building--poor .building__cost {
    color: rgb(255, 120, 100);
}

.info {
    color: rgb(240, 230, 210);
    font-size: 16px;
    background-color: rgba(22, 14, 10, 0.88);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    padding: 4px 8px;
    margin-bottom: 6px;
    max-width: 640px;
    white-space: normal;
}

.toast {
    color: rgb(255, 200, 150);
    font-size: 20px;
    background-color: rgba(40, 14, 6, 0.85);
    padding: 3px 10px;
    margin-bottom: 6px;
}

.tool--toggle {
    width: auto;
}

.tool--on {
    border-color: rgb(120, 220, 140);
    background-color: rgb(30, 64, 40);
}

.resource__rate {
    color: rgb(150, 220, 140);
    font-size: 16px;
    padding: 0;
    margin-left: 4px;
}

.resource__rate--negative {
    color: rgb(255, 130, 100);
}

.tool {
    width: 112px;
    height: 34px;
    margin: 0 4px;
    background-color: rgb(40, 26, 18);
    color: rgb(230, 215, 190);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    border-radius: 0;
    font-size: 20px;
}

.tool:hover {
    background-color: rgb(62, 41, 28);
}

.tool--active {
    border-color: rgb(255, 190, 90);
    background-color: rgb(86, 54, 30);
}

/* ---------------------------------------------------------------- Milestone 4: side panels, abilities, modals */

.panel {
    background-color: rgba(22, 14, 10, 0.9);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    padding: 6px 8px;
}

.panel__title {
    color: rgb(255, 210, 140);
    font-size: 20px;
    padding: 0;
    margin: 0 0 4px 0;
}

.side {
    position: absolute;
    top: 64px;
    width: 250px;
    flex-direction: column;
}

.side--left {
    left: 8px;
    top: 150px;
}

.side--right {
    right: 8px;
}

/* Contracts */
.contract {
    margin-bottom: 5px;
    padding: 4px 6px;
    background-color: rgb(40, 26, 18);
    border-width: 1px;
    border-color: rgb(70, 48, 32);
}

.contract--done {
    border-color: rgb(255, 200, 90);
    background-color: rgb(70, 48, 22);
}

.contract__title {
    color: rgb(240, 230, 210);
    font-size: 16px;
    padding: 0;
    margin: 0;
}

.contract__text {
    color: rgb(200, 185, 160);
    font-size: 16px;
    padding: 0;
    margin: 1px 0 0 0;
    white-space: normal;
}

.contract__reward {
    color: rgb(190, 170, 255);
    font-size: 16px;
    padding: 0;
    margin: 1px 0 0 0;
    white-space: normal;
}

.bar {
    height: 5px;
    margin-top: 3px;
    background-color: rgb(24, 16, 12);
}

.bar__fill {
    height: 100%;
    width: 0;
    background-color: rgb(150, 210, 110);
}

.claim {
    height: 22px;
    margin: 4px 0 0 0;
    background-color: rgb(110, 80, 30);
    color: rgb(255, 235, 190);
    border-width: 1px;
    border-color: rgb(255, 200, 90);
    border-radius: 0;
    font-size: 16px;
}

.claim:hover {
    background-color: rgb(150, 110, 40);
}

/* Random events */
.event {
    margin-bottom: 5px;
    padding: 4px 6px;
    background-color: rgba(30, 22, 44, 0.92);
    border-width: 2px;
    border-color: rgb(150, 120, 220);
}

/* Raids: red until they end */
.event--danger {
    border-color: rgb(230, 90, 70);
    background-color: rgba(48, 16, 12, 0.92);
}

.event--won {
    border-color: rgb(120, 220, 140);
}

.event--lost {
    border-color: rgb(200, 90, 80);
}

.event__row {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.event__timer {
    color: rgb(255, 210, 140);
    font-size: 16px;
    flex-grow: 1;
    padding: 0;
    margin: 0;
}

.small-button {
    height: 20px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    background-color: rgb(52, 40, 70);
    color: rgb(235, 225, 255);
    border-width: 1px;
    border-color: rgb(150, 120, 220);
    border-radius: 0;
    font-size: 16px;
}

.small-button:hover {
    background-color: rgb(80, 62, 108);
}

/* Soldier share, at the end of the toolbar */
.soldiers {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 2px 4px;
    background-color: rgba(22, 14, 10, 0.88);
    border-width: 2px;
    border-color: rgb(140, 50, 36);
}

.soldiers__label {
    color: rgb(240, 230, 210);
    font-size: 20px;
    margin: 0 0 0 6px;
    padding: 0;
}

/* Abilities: a column at the bottom right */
.abilities {
    position: absolute;
    right: 8px;
    bottom: 10px;
    flex-direction: column;
    align-items: flex-end;
}

.tool--ability {
    width: 190px;
    margin: 3px 0 0 0;
    border-left-width: 5px;
    -unity-text-align: middle-left;
    padding-left: 8px;
}

.tool--cooling {
    color: rgb(140, 125, 110);
}

.tool--running {
    background-color: rgb(90, 50, 20);
    border-color: rgb(255, 160, 70);
}

.tool--targeting {
    border-color: rgb(127, 216, 255);
    background-color: rgb(24, 56, 72);
}

.resource--knowledge .resource__label {
    color: rgb(205, 190, 255);
}

.building--locked {
    opacity: 0.55;
}

.building--locked .building__cost {
    color: rgb(190, 170, 255);
}

/* Modal layer: menu, research, welcome back */
.modal {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    background-color: rgba(8, 5, 4, 0.55);
    align-items: center;
    justify-content: center;
}

.dialog {
    min-width: 320px;
    max-width: 560px;
    padding: 12px 16px;
}

.dialog__title {
    color: rgb(255, 210, 140);
    font-size: 24px;
    margin-bottom: 6px;
    padding: 0;
}

.dialog__text {
    color: rgb(230, 220, 200);
    font-size: 20px;
    white-space: normal;
    padding: 0;
    margin: 2px 0;
}

.dialog__note {
    color: rgb(170, 155, 135);
    font-size: 16px;
    white-space: normal;
    padding: 0;
    margin: 6px 0 2px 0;
}

.menu-button {
    height: 32px;
    margin: 3px 0;
    background-color: rgb(40, 26, 18);
    color: rgb(240, 230, 210);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    border-radius: 0;
    font-size: 20px;
}

.menu-button:hover {
    background-color: rgb(62, 41, 28);
}

.menu-button--warn {
    border-color: rgb(220, 110, 80);
    color: rgb(255, 170, 140);
}

/* Research tree */
.research {
    width: 1180px;
    max-width: 96%;
    padding: 10px 12px;
}

.research__header {
    flex-direction: row;
    align-items: center;
}

.research__knowledge {
    color: rgb(205, 190, 255);
    font-size: 20px;
    flex-grow: 1;
    -unity-text-align: middle-right;
    margin-right: 10px;
}

.research__columns {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

.research__column {
    flex-direction: column;
    width: 16%;
}

.research__tier {
    color: rgb(170, 155, 135);
    font-size: 16px;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.node {
    height: 52px;
    margin: 3px 0;
    padding: 2px 6px;
    background-color: rgb(34, 24, 18);
    border-width: 2px;
    border-color: rgb(60, 44, 32);
    border-radius: 0;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
}

.node__name {
    color: rgb(160, 145, 125);
    font-size: 16px;
    padding: 0;
    margin: 0;
}

.node__cost {
    color: rgb(130, 118, 100);
    font-size: 16px;
    padding: 0;
    margin: 0;
    white-space: normal;
}

.node--available {
    border-color: rgb(120, 100, 180);
    background-color: rgb(40, 30, 50);
}

.node--available .node__name {
    color: rgb(230, 220, 255);
}

.node--available .node__cost {
    color: rgb(255, 140, 120);
}

.node--affordable {
    border-color: rgb(205, 190, 255);
    background-color: rgb(56, 42, 84);
}

.node--affordable .node__cost {
    color: rgb(205, 190, 255);
}

.node--affordable:hover {
    background-color: rgb(76, 58, 112);
}

.node--done {
    border-color: rgb(120, 200, 120);
    background-color: rgb(30, 52, 32);
}

.node--done .node__name {
    color: rgb(190, 240, 190);
}

.node--done .node__cost {
    color: rgb(140, 200, 140);
}

.node-spacer {
    height: 52px;
    margin: 3px 0;
}

.research__detail {
    color: rgb(230, 220, 200);
    font-size: 16px;
    white-space: normal;
    margin-top: 8px;
    min-height: 48px;
    padding: 4px 6px;
    background-color: rgb(30, 20, 14);
}

/* Milestone 6: castes panel, scent palette, possession */
.tool--narrow {
    width: auto;
    min-width: 64px;
    padding: 0 10px;
}
.castes {
    position: absolute;
    left: 8px;
    bottom: 64px;
    min-width: 300px;
}
.caste {
    flex-direction: row;
    align-items: center;
    height: 24px;
}
.caste__swatch {
    width: 8px;
    height: 14px;
    margin-right: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}
.caste__name {
    color: rgb(240, 230, 210);
    font-size: 20px;
    width: 76px;
    margin: 0;
    padding: 0;
}
.caste__count {
    color: rgb(200, 185, 160);
    font-size: 16px;
    width: 104px;
    margin: 0;
    padding: 0;
}
.caste__share {
    color: rgb(255, 210, 140);
    font-size: 20px;
    width: 54px;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}
.caste__share--rest {
    color: rgb(170, 160, 140);
    width: 78px;
}
.caste__hint {
    color: rgb(170, 160, 140);
    font-size: 16px;
    white-space: normal;
    max-width: 300px;
    margin: 4px 0 0 0;
    padding: 0;
}
.scent {
    width: 132px;
}
.tool--possessing {
    border-color: rgb(255, 210, 90);
    color: rgb(255, 230, 150);
}

/* Milestone 7: Nuptial Flight, genetic tree, princesses */
.flight {
    max-width: 680px;
    width: 680px;
}
.flight__heading {
    color: rgb(255, 210, 140);
    font-size: 20px;
    margin: 8px 0 0 0;
    padding: 0;
}
.flight__modifiers {
    flex-direction: column;
    margin: 2px 0 4px 0;
}
.modifier {
    flex-direction: row;
    align-items: center;
    min-height: 26px;
    margin: 1px 0;
    padding: 2px 6px;
    background-color: rgb(34, 24, 18);
    border-width: 2px;
    border-color: rgb(60, 44, 32);
    border-radius: 0;
}
.modifier:hover {
    background-color: rgb(52, 36, 26);
}
.modifier__swatch {
    width: 8px;
    height: 14px;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.6);
}
.modifier__text {
    color: rgb(220, 205, 180);
    font-size: 16px;
    white-space: normal;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
}
.modifier--chosen {
    border-color: rgb(255, 210, 110);
    background-color: rgb(70, 52, 24);
}
.modifier--chosen .modifier__text {
    color: rgb(255, 235, 180);
}
.modifier--locked .modifier__text {
    color: rgb(130, 118, 100);
}
.genetics {
    width: 1000px;
}
.genetics .research__knowledge {
    color: rgb(255, 215, 120);
}
.genetics .node--available {
    border-color: rgb(170, 130, 60);
    background-color: rgb(48, 36, 20);
}
.genetics .node--available .node__name {
    color: rgb(255, 235, 190);
}
.genetics .node--affordable {
    border-color: rgb(255, 210, 110);
    background-color: rgb(84, 62, 26);
}
.genetics .node--affordable .node__cost {
    color: rgb(255, 220, 140);
}
.genetics .node--affordable:hover {
    background-color: rgb(112, 84, 34);
}
.genetics .node--owned {
    border-left-color: rgb(120, 200, 120);
    border-left-width: 4px;
}
.resource--memory .resource__label {
    color: rgb(255, 215, 120);
}
.tool--ready {
    border-color: rgb(255, 210, 110);
    color: rgb(255, 230, 160);
}

/* ---------------------------------------------------------------- Milestone 8: pixel skin, feedback, new screens */

/* Pixel bevels drawn over each element's background colour (see Antarium/Setup/Create UI Skin). */
.panel, .resources, .palette, .info, .toast, .alert, .event, .castes {
    background-image: url("Skin/frame.png");
    -unity-slice-left: 2; -unity-slice-right: 2; -unity-slice-top: 2; -unity-slice-bottom: 2;
    -unity-slice-scale: 2px;
}
.tool, .menu-button, .building, .claim, .small-button, .node, .modifier, .contract, .option__button, .key-button {
    background-image: url("Skin/bevel.png");
    -unity-slice-left: 1; -unity-slice-right: 1; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 2px;
    transition-property: translate, background-color, border-color;
    transition-duration: 0.06s;
}
.tool:active, .menu-button:active, .building:active, .claim:active, .small-button:active, .node:active, .modifier:active,
.option__button:active, .key-button:active {
    background-image: url("Skin/bevel_down.png");
    translate: 0 2px;
}
.bar, .slot {
    background-image: url("Skin/inset.png");
    -unity-slice-left: 1; -unity-slice-right: 1; -unity-slice-top: 1; -unity-slice-bottom: 1;
    -unity-slice-scale: 2px;
}
.bar {
    height: 8px;
}

/* Titles in Silkscreen (capitals) */
.panel__title, .dialog__title, .title__logo, .flight__heading, .help__heading {
    -unity-font-definition: url("Fonts/Silkscreen-Regular.asset");
}
.panel__title, .flight__heading, .help__heading {
    font-size: 16px;
}

/* Dialogs pop in: the class is removed one frame after the dialog is shown. */
.dialog, .research, .flight, .genetics {
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    transition-timing-function: ease-out-back;
}
.pop-enter {
    opacity: 0;
    scale: 0.94 0.94;
}
.toast {
    transition-property: opacity, translate;
    transition-duration: 0.15s;
}
.toast--enter {
    opacity: 0;
    translate: 0 6px;
}

/* Title screen */
.title {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(8, 5, 4, 0.35);
    transition-property: opacity;
    transition-duration: 0.4s;
}
.title--leaving {
    opacity: 0;
}
.title__logo {
    color: rgb(255, 210, 140);
    font-size: 64px;
    -unity-text-align: middle-center;
    text-shadow: 4px 4px 0 rgb(40, 18, 8);
    margin: 0;
    padding: 0;
}
.title__tagline {
    color: rgb(230, 215, 190);
    font-size: 20px;
    -unity-text-align: middle-center;
    text-shadow: 2px 2px 0 rgb(20, 10, 6);
    margin: 0 0 24px 0;
}
.title__menu {
    width: 340px;
}
.title__version {
    position: absolute;
    right: 12px;
    bottom: 8px;
    color: rgb(170, 155, 135);
    font-size: 16px;
}
.hud--title .top-bar, .hud--title .alert-row, .hud--title .side, .hud--title .bottom, .hud--title .abilities,
.hud--title .castes, .hud--title .debug {
    display: none;
}

/* Settings */
.settings {
    width: 640px;
    max-width: 96%;
}
.tabs {
    flex-direction: row;
    margin: 0 0 8px 0;
}
.tab {
    flex-grow: 1;
    margin: 0 2px;
}
.tab--active {
    border-color: rgb(255, 190, 90);
    background-color: rgb(86, 54, 30);
}
.option {
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin: 1px 0;
}
.option__label {
    color: rgb(230, 220, 200);
    font-size: 20px;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}
.option__button {
    width: 30px;
    height: 26px;
    margin: 0;
    padding: 0;
    background-color: rgb(40, 26, 18);
    color: rgb(240, 230, 210);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    border-radius: 0;
    font-size: 20px;
}
.option__button:hover {
    background-color: rgb(62, 41, 28);
}
.option__value {
    color: rgb(255, 210, 140);
    font-size: 20px;
    width: 190px;
    -unity-text-align: middle-center;
    margin: 0 4px;
    padding: 0;
}
.key-button {
    width: 236px;
    height: 26px;
    margin: 0;
    background-color: rgb(40, 26, 18);
    color: rgb(255, 210, 140);
    border-width: 2px;
    border-color: rgb(96, 64, 42);
    border-radius: 0;
    font-size: 20px;
}
.key-button:hover {
    background-color: rgb(62, 41, 28);
}
.key-button--waiting {
    border-color: rgb(127, 216, 255);
    color: rgb(127, 216, 255);
}
.settings__page {
    min-height: 300px;
}
.scroll {
    max-height: 420px;
}
.row-buttons {
    flex-direction: row;
    margin-top: 6px;
}
.row-buttons > .menu-button {
    flex-grow: 1;
    margin: 3px 2px;
}

/* Achievements */
.achievement {
    flex-direction: row;
    align-items: center;
    margin: 2px 0;
    padding: 4px 6px;
    background-color: rgb(34, 24, 18);
    border-width: 2px;
    border-color: rgb(60, 44, 32);
}
.achievement--done {
    border-color: rgb(255, 210, 110);
    background-color: rgb(60, 44, 20);
}
.achievement__icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
    background-color: rgb(60, 44, 32);
    border-width: 2px;
    border-color: rgb(20, 12, 8);
}
.achievement--done .achievement__icon {
    background-color: rgb(255, 210, 110);
}
.achievement__text {
    flex-grow: 1;
    flex-shrink: 1;
}
.achievement__name {
    color: rgb(240, 230, 210);
    font-size: 20px;
    margin: 0;
    padding: 0;
}
.achievement__desc {
    color: rgb(190, 175, 150);
    font-size: 16px;
    white-space: normal;
    margin: 0;
    padding: 0;
}
.achievement__progress {
    color: rgb(170, 155, 135);
    font-size: 16px;
    width: 110px;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

/* Help */
.help__row {
    flex-direction: row;
    margin: 1px 0;
}
.help__key {
    color: rgb(255, 210, 140);
    font-size: 20px;
    width: 180px;
    margin: 0;
    padding: 0;
}
.help__text {
    color: rgb(230, 220, 200);
    font-size: 20px;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin: 0;
    padding: 0;
}
.help__heading {
    color: rgb(255, 210, 140);
    font-size: 20px;
    margin: 8px 0 2px 0;
    padding: 0;
}

.hud--title .modal {
    background-color: rgba(8, 5, 4, 0.85);
}

/* Scrollbars in the skin colours */
.unity-scroller--vertical {
    width: 12px;
}
.unity-scroller__low-button, .unity-scroller__high-button {
    display: none;
}
.unity-scroller .unity-base-slider__tracker {
    background-color: rgb(24, 16, 12);
    border-color: rgb(60, 44, 32);
}
.unity-scroller .unity-base-slider__dragger {
    background-color: rgb(96, 64, 42);
    border-color: rgb(140, 100, 64);
}
