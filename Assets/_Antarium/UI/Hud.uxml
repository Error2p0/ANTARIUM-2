<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud" class="hud" picking-mode="Ignore">
        <ui:VisualElement name="top-bar" class="top-bar" picking-mode="Ignore">
            <ui:VisualElement name="resources" class="resources" />
        </ui:VisualElement>
        <ui:VisualElement name="alert-row" class="alert-row" picking-mode="Ignore">
            <ui:Label name="alert" class="alert hidden" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:Label name="debug" class="debug" picking-mode="Ignore" />
        <ui:VisualElement name="events" class="side side--left" picking-mode="Ignore" />
        <ui:VisualElement name="contracts" class="side side--right" picking-mode="Ignore" />
        <ui:VisualElement name="bottom" class="bottom" picking-mode="Ignore">
            <ui:Label name="toast" class="toast hidden" picking-mode="Ignore" />
            <ui:Label name="info" class="info hidden" picking-mode="Ignore" />
            <ui:VisualElement name="build-palette" class="palette hidden" picking-mode="Ignore" />
            <ui:VisualElement name="toolbar" class="toolbar" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="abilities" class="abilities" picking-mode="Ignore" />
        <ui:VisualElement name="modal" class="modal hidden" />
    </ui:VisualElement>
</ui:UXML>
