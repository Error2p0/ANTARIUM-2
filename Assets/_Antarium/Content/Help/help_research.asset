  m_Script: {fileID: 11500000, guid: 810031e0539baf849a8ec048a6ff4b7a, type: 3}
  m_Name: help_research
  m_EditorClassIdentifier: Antarium.Content::Antarium.Content.HelpTopicDef
  id: help_research
  displayName: Knowledge and research
  order: 300
  category: Colony
  icon: tool_research
  body: 'Knowledge (violet in the top bar) buys research. It comes from claiming contracts, from events, and from the Archive, which studies copper, crystals, amber, fossils and rarer finds.


    Press {Research} for the research tree. A node you can buy now glows violet; grey ones need other research first. Point at a node to see what it does and costs, and click to buy it. Research is instant and lasts for the whole colony.


    Research unlocks buildings, castes and abilities, and makes the colony faster.'
  reveal: 0
  revealBiome: {fileID: 0}
  revealResearch: {fileID: 0}
