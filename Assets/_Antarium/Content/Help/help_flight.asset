  m_Name: help_flight
  m_EditorClassIdentifier: Antarium.Content::Antarium.Content.HelpTopicDef
  id: help_flight
  displayName: The Nuptial Flight
  order: 620
  category: Late game
  icon: tool_flight
  body: 'When a colony slows down, send princesses to found a new one. Build a Princess Chamber and feed it fungus and amber: it raises princesses.


    Press {Flight} to see what a flight would earn: Genetic Memory, more for a deeper, more developed colony and for more princesses. Pick world modifiers for the next colony there; harder worlds earn more.


    Taking flight ends this colony. The next one starts on a new world, and the Genetic Memory is yours to spend.'
  reveal: 3
  revealBiome: {fileID: 0}
  revealResearch: {fileID: 11400000, guid: 275c010452000b34390e5babf3d92fe8, type: 2}
