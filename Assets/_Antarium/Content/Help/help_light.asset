  m_Name: help_light
  m_EditorClassIdentifier: Antarium.Content::Antarium.Content.HelpTopicDef
  id: help_light
  displayName: Light and darkness
  order: 460
  category: World
  icon: item_glow_mushroom
  body: 'Sunlight reaches into tunnels near the surface and fades deeper down. Glowing crystals, mushrooms, magma and lava light their surroundings, and glow ants carry light with them.


    Light only matters for your eyes: ants work just as well in the dark. Unexplored rock is black; explored tunnels without light are dim. The research Guiding Light puts a light at your pointer.'
  reveal: 0
  revealBiome: {fileID: 0}
  revealResearch: {fileID: 0}
