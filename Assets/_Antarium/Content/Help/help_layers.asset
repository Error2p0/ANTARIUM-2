  m_Name: help_layers
  m_EditorClassIdentifier: Antarium.Content::Antarium.Content.HelpTopicDef
  id: help_layers
  displayName: The deep layers
  order: 420
  category: World
  icon: item_iron_ore
  body: 'The world changes layer by layer as you dig down, starting with the topsoil, the clay and the stone. Every layer has its own rock, finds and dangers, and its rock is harder to dig.


    Point at a cell to see what it is; the ore overlay ({Ores}) shows every find you know of.


    Hauling from deep down means long walks. Lifts and belts bring finds up a shaft, and storage near the digging saves trips.'
  reveal: 1
  revealBiome: {fileID: 11400000, guid: 6dd87aa3e609aa848bd80e10513cee77, type: 2}
  revealResearch: {fileID: 0}
