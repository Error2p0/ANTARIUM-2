  m_Script: {fileID: 11500000, guid: 810031e0539baf849a8ec048a6ff4b7a, type: 3}
  m_Name: help_stock
  m_EditorClassIdentifier: Antarium.Content::Antarium.Content.HelpTopicDef
  id: help_stock
  displayName: Stock, filters and chests
  order: 230
  category: Building
  icon: building_chest
  body: 'Click an item in the top bar for the stock view and set how many of each item to keep for building. Machines and unloaders never take the stock below that.


    {Configure} on a storage zone or a chest chooses which items it takes; everything else goes elsewhere. A chest holds many items in one cell, and a belt that ends at a chest fills it.


    Unloaders (research Stockkeeping) take items out of the storage cell, chest or royal chamber behind them and put them onto the belt or machine their arrow points at: a chest of ore next to a smelter feeds it directly.'
  reveal: 0
  revealBiome: {fileID: 0}
  revealResearch: {fileID: 0}
