  m_Name: help_growth
  m_EditorClassIdentifier: Antarium.Content::Antarium.Content.HelpTopicDef
  id: help_growth
  displayName: Experience and traits
  order: 360
  category: Colony
  icon: trait_strong
  body: 'An ant''s first job becomes its skill. Working at it gives experience, and every level makes it a little faster at that job. Point at an ant to see its skill and level.


    About one ant in three hatches with a trait: Strong ones carry more, Swift ones walk faster, Lucky ones find more, and Lazy ones take their time.


    The queen''s evolutions ({Queen}) make every ant tougher, quicker to heal, and more.'
  reveal: 0
  revealBiome: {fileID: 0}
  revealResearch: {fileID: 0}
